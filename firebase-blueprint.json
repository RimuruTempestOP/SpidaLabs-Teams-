{
  "entities": {
    "User": {
      "title": "User",
      "description": "User profile and team membership",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "maxLength": 128 },
        "email": { "type": "string", "format": "email", "maxLength": 128 },
        "name": { "type": "string", "maxLength": 100 },
        "role": { "type": "string", "maxLength": 50 },
        "team": { "type": "string", "maxLength": 100 },
        "avatar": { "type": "string", "maxLength": 500 },
        "status": { "type": "string", "maxLength": 50 },
        "createdAt": { "type": "string" }
      },
      "required": ["uid", "email", "name", "role", "team"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message in global or team space",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128 },
        "text": { "type": "string", "maxLength": 5000 },
        "senderId": { "type": "string", "maxLength": 128 },
        "senderName": { "type": "string", "maxLength": 100 },
        "senderRole": { "type": "string", "maxLength": 50 },
        "senderTeam": { "type": "string", "maxLength": 100 },
        "senderAvatar": { "type": "string", "maxLength": 500 },
        "teamId": { "type": "string", "maxLength": 100 },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "text", "senderId", "teamId", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "User" },
      "description": "User profiles"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "Message" },
      "description": "Global and team chat messages with strict privacy checks"
    }
  }
}
